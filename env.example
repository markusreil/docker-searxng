# Global
COMPOSE_PROJECT_NAME=searxng
# Base domain for vhost names; e.g. localhost maps to searxng.localhost
BASE_DOMAIN=localhost
# Docker network owned by the proxy cluster
NGINX_PROXY_NETWORK=web-proxy

# --- searxng ---
# SearXNG image tag
SEARXNG_VERSION=latest
# Long random secret for SearXNG sessions (generate with: openssl rand -hex 32)
SEARXNG_SECRET=change-me-to-32-plus-random-chars-minimum-length
# Homepage integration (optional overrides)
HOMEPAGE_GROUP=Search
HOMEPAGE_NAME=SearXNG
HOMEPAGE_ICON=searxng
HOMEPAGE_DESCRIPTION=Privacy-respecting metasearch engine
